{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@crossfire/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "apps", "packages"],
  "references": [
    {
      "path": "apps/server"
    },
    {
      "path": "apps/web"
    },
    {
      "path": "packages/database"
    },
    {
      "path": "packages/shared"
    }
  ]
}
