# Environment Configuration
# Copy this file to .env and fill in the values
# WARNING: Example values are for local development only.
# Never use these defaults in production.

# Server
HOST=localhost
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crossfire
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crossfire
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_CIRCUIT_BREAKER_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_RESET=30000

# Auth
AUTH_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Game Server
GAME_TICK_RATE=20
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=16

# Logging
LOG_LEVEL=debug

# Performance Tuning
ROOM_TTL_SECONDS=3600
ROOM_MAX_CONCURRENCY=5
DEFAULT_MAX_PLAYERS_PER_ROOM=10
MATCHMAKING_MAX_CONCURRENCY=5
LEADERBOARD_MAX_DEFINITIONS=5
STATIC_DATA_CACHE_TTL_SECONDS=3600
LEADERBOARD_CACHE_TTL_SECONDS=300
