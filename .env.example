# Environment Configuration
# Copy this file to .env and fill in the values
# WARNING: Example values are for local development only.
# Never use these defaults in production.

# Server
HOST=localhost
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crossfire
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crossfire
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
AUTH_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Game Server
GAME_TICK_RATE=20
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=16

# Logging
LOG_LEVEL=debug
